# Install dependencies in the image, not from the host.
node_modules
**/node_modules

# The image builds its own output.
dist

# Git and local agent files.
.git
.gitignore
.gitattributes
.claude
.superpowers

# Docs
docs
README.md

# Tests stay out of the image.
test
**/*.spec.ts

# Compose supplies environment values.
.env
.env.*
!.env.example

# Local tooling files.
.vscode
.idea
*.log
npm-debug.log*
coverage
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml
