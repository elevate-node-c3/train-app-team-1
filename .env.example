# Copy to .env before `docker compose up`:
#
#   cp .env.example .env
#
# Every variable docker-compose.yml interpolates is listed here, and a test
# fails the build if that stops being true. Each one also has the same default
# baked into docker-compose.yml, so `docker compose up` works on a fresh clone
# even without this file; copying it is what lets you change anything.
#
# These are local development credentials, not secrets — .env is gitignored.

NODE_ENV=development

# Postgres superuser. Used for administration and the healthcheck only; no
# service holds these. POSTGRES_DB is just the container's own default
# database — the seven service databases are created by
# docker/postgres/init/01-create-databases.sh.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# One login role per service, each owning its own database and able to open no
# other. The init script reads these on first start only: changing one means
# `docker compose down -v` to recreate the roles.
CATALOG_DB_PASSWORD=catalog_dev
GATEWAY_DB_PASSWORD=gateway_dev
IDENTITY_DB_PASSWORD=identity_dev
INVENTORY_DB_PASSWORD=inventory_dev
BOOKING_DB_PASSWORD=booking_dev
PAYMENT_DB_PASSWORD=payment_dev
NOTIFICATION_DB_PASSWORD=notification_dev

# RabbitMQ broker credentials, also used to sign in to the management UI.
RABBITMQ_USER=train_app
RABBITMQ_PASSWORD=train_app

# Host ports. Change these if something already owns them locally — nothing
# else needs editing. The two dev UIs bind to 127.0.0.1 only.
GATEWAY_PORT=3000
RABBITMQ_MANAGEMENT_PORT=15672
MAILPIT_UI_PORT=8025

# Identity's outbox relay. The relay publishes committed rows independently of
# the sign-up request, so sign-up stays fast while the broker is unreachable.
# A partial index keeps the poll proportional to the backlog, not to history.
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=20
# Hard cap: a code in a dead-lettered message must stop working within ten
# minutes. The Joi schema rejects anything above 600.
VERIFICATION_CODE_TTL_SECONDS=600

# Access-token signing and verification.
JWT_KEY_ID=dev-1
# How much clock drift the verifier tolerates on `exp`, `iat` and `nbf`.
JWT_CLOCK_SKEW_SECONDS=30
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_TOKEN_GRACE_SECONDS=10
# Required outside local development: encrypts the 10-second refresh replay.
TOKEN_GRACE_SECRET=change-me-in-production
# JWT_PRIVATE_KEY=
# JWT_PRIVATE_KEY_FILE=config/jwt/dev-private.pem
# JWT_PUBLIC_KEY=
# JWT_PUBLIC_KEY_FILE=config/jwt/dev-public.pem
# JWT_PREVIOUS_KEY_ID=
# JWT_PREVIOUS_PUBLIC_KEY_FILE=

# BR-01 staff seed. These are read by the one-shot identity-seed service or by
# `npm run seed:staff`, not by identity itself. Development defaults are
# deliberately public; production must set both or the seed refuses to run.
OPERATOR_SEED_PASSWORD=Operator!Dev123
CONDUCTOR_SEED_PASSWORD=Conductor!Dev123
BCRYPT_COST=12

# Notification's consumer and SMTP delivery. EVENT_HANDLER_TIMEOUT_MS is also
# the SMTP connection/greeting/socket timeout, so one hung socket cannot eat
# the whole BR-03 budget. EVENT_RETRY_DELAYS_MS is checked against BR-03 by the
# Joi schema; the three delays mean four attempts in total.
SMTP_FROM=no-reply@train.local
EVENT_HANDLER_TIMEOUT_MS=3000
EVENT_RETRY_DELAYS_MS=1000,3000,9000
EVENT_PREFETCH=10
EVENT_CLAIM_LEASE_SECONDS=60

# gRPC internal endpoints
CATALOG_GRPC_URL=catalog:50051
IDENTITY_GRPC_URL=identity:50051
INVENTORY_GRPC_URL=inventory:50051
BOOKING_GRPC_URL=booking:50051
PAYMENT_GRPC_URL=payment:50051
NOTIFICATION_GRPC_URL=notification:50051
