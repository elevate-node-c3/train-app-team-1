# Copy to .env to change the local Compose defaults:
#   cp .env.example .env
# Compose works without .env by using these defaults.
# Development credentials are public; keep .env out of Git.

NODE_ENV=development

# Postgres admin and healthcheck only; services use their own roles.
# POSTGRES_DB is the container default; the init script creates service databases.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Each service can access only its own database.
# Password changes need `docker compose down -v`, which deletes local data.
CATALOG_DB_PASSWORD=catalog_dev
GATEWAY_DB_PASSWORD=gateway_dev
IDENTITY_DB_PASSWORD=identity_dev
INVENTORY_DB_PASSWORD=inventory_dev
BOOKING_DB_PASSWORD=booking_dev
PAYMENT_DB_PASSWORD=payment_dev
NOTIFICATION_DB_PASSWORD=notification_dev

# RabbitMQ login, including the management UI.
RABBITMQ_USER=train_app
RABBITMQ_PASSWORD=train_app

# Host ports; dev UIs listen only on 127.0.0.1.
GATEWAY_PORT=3000
RABBITMQ_MANAGEMENT_PORT=15672
MAILPIT_UI_PORT=8025

# Background delivery keeps sign-up fast when the broker is down.
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=20

# MT-02: database scans own expiry; these are idle scan intervals, not hold timers.
HOLD_CREATION_ENABLED=false
HOLD_EXPIRY_WORKER_ENABLED=true
HOLD_EXPIRY_BATCH_SIZE=500
HOLD_EXPIRY_POLL_INTERVAL_MS=250
INVENTORY_OUTBOX_BATCH_SIZE=100
INVENTORY_OUTBOX_POLL_INTERVAL_MS=100
INVENTORY_OUTBOX_PUBLISH_CONCURRENCY=32
AMQP_PUBLISH_CONFIRM_TIMEOUT_MS=5000
# Provision two distinct random secrets (at least 32 characters). Left empty
# on purpose: there is no default, and a service refuses to boot without one.
BOOKING_INVENTORY_SERVICE_KEY=
BOOKING_IDENTITY_SERVICE_KEY=
# Optional, unlike the two above: notification boots without it and only loses
# the identity lookup that backfills an address for a historical booking.
NOTIFICATION_IDENTITY_SERVICE_KEY=
# Identity-only JSON map of positive versions to base64 keys (at least 32 bytes).
# Retain keys for every pinned trip; never replace key material under a version.
HOLD_PASSENGER_TOKEN_KEYS=
HOLD_PASSENGER_TOKEN_ACTIVE_VERSION=1
# Identity-only AES-256-GCM keyring and separate HMAC blind-index key.
# Retain old encryption versions until all ciphertext has been rotated.
NATIONAL_ID_ACTIVE_KEY_VERSION=1
NATIONAL_ID_ENCRYPTION_KEYS=
NATIONAL_ID_BLIND_INDEX_KEY=

# Fill the booking window from today; retry missed days on the next run.
TRIP_GENERATION_ENABLED=true
TRIP_GENERATION_INTERVAL_MS=86400000

# Verification codes expire within 10 minutes; values above 600 are rejected.
VERIFICATION_CODE_TTL_SECONDS=600

# Access-token signing and verification.
JWT_KEY_ID=dev-1
# Allowed clock drift for exp, iat, and nbf.
JWT_CLOCK_SKEW_SECONDS=30
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_TOKEN_GRACE_SECONDS=10
# Encrypt refresh-token retries; required outside development.
TOKEN_GRACE_SECRET=change-me-in-production
# JWT_PRIVATE_KEY=
# JWT_PRIVATE_KEY_FILE=config/jwt/dev-private.pem
# JWT_PUBLIC_KEY=
# JWT_PUBLIC_KEY_FILE=config/jwt/dev-public.pem
# JWT_PREVIOUS_KEY_ID=
# JWT_PREVIOUS_PUBLIC_KEY_FILE=

# Ticket QR and share-link signing (booking only, Ed25519). `npm run
# keys:generate` writes the development key that Compose mounts. To rotate,
# give the new key a new id and keep the old public key in
# TICKET_RETIRED_PUBLIC_KEYS (JSON: {"<id>":"<PEM>"}) for as long as tickets
# it signed may still be travelled on.
TICKET_SIGNING_KEY_ID=ticket-dev-1
TICKET_RETIRED_PUBLIC_KEYS=
# TICKET_SIGNING_PRIVATE_KEY=
# TICKET_SIGNING_PRIVATE_KEY_FILE=config/ticket-signing/dev-private.pem

# Staff seed passwords for the seeder or `npm run seed:staff`.
# Production must set both; local defaults are public.
OPERATOR_SEED_PASSWORD=Operator!Dev123
CONDUCTOR_SEED_PASSWORD=Conductor!Dev123
BCRYPT_COST=12

# SMTP uses the handler timeout; Joi checks the total delivery time.
# Verification emails have four attempts; booking outcomes keep retrying the final delay.
SMTP_FROM=no-reply@train.local
EVENT_HANDLER_TIMEOUT_MS=3000
EVENT_RETRY_DELAYS_MS=1000,3000,9000
EVENT_PREFETCH=10
EVENT_CLAIM_LEASE_SECONDS=60

# Internal gRPC addresses
CATALOG_GRPC_URL=catalog:50051
IDENTITY_GRPC_URL=identity:50051
INVENTORY_GRPC_URL=inventory:50051
BOOKING_GRPC_URL=booking:50051
PAYMENT_GRPC_URL=payment:50051
NOTIFICATION_GRPC_URL=notification:50051

# Stripe Configuration (Payment Service only)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

