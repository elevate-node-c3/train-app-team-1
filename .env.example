# Copy to .env before `docker compose up`:
#
#   cp .env.example .env
#
# Every variable docker-compose.yml interpolates is listed here, and a test
# fails the build if that stops being true. These are local development
# credentials, not secrets — .env itself is gitignored.

NODE_ENV=development

# Postgres. POSTGRES_DB is only the container's own default database; the seven
# per-service databases are created by docker/postgres/init/01-create-databases.sql.
POSTGRES_USER=train_app
POSTGRES_PASSWORD=train_app
POSTGRES_DB=train_app

# RabbitMQ broker credentials, also used to sign in to the management UI.
RABBITMQ_USER=train_app
RABBITMQ_PASSWORD=train_app

# Host ports. Change these if something already owns them locally — nothing
# else needs editing.
GATEWAY_PORT=3000
RABBITMQ_MANAGEMENT_PORT=15672
MAILPIT_UI_PORT=8025
