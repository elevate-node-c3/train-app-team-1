# Copy to .env before `docker compose up`:
#
#   cp .env.example .env
#
# Every variable docker-compose.yml interpolates is listed here, and a test
# fails the build if that stops being true. Each one also has the same default
# baked into docker-compose.yml, so `docker compose up` works on a fresh clone
# even without this file; copying it is what lets you change anything.
#
# These are local development credentials, not secrets — .env is gitignored.

NODE_ENV=development

# Postgres superuser. Used for administration and the healthcheck only; no
# service holds these. POSTGRES_DB is just the container's own default
# database — the seven service databases are created by
# docker/postgres/init/01-create-databases.sh.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# One login role per service, each owning its own database and able to open no
# other. The init script reads these on first start only: changing one means
# `docker compose down -v` to recreate the roles.
CATALOG_DB_PASSWORD=catalog_dev
GATEWAY_DB_PASSWORD=gateway_dev
IDENTITY_DB_PASSWORD=identity_dev
INVENTORY_DB_PASSWORD=inventory_dev
BOOKING_DB_PASSWORD=booking_dev
PAYMENT_DB_PASSWORD=payment_dev
NOTIFICATION_DB_PASSWORD=notification_dev

# RabbitMQ broker credentials, also used to sign in to the management UI.
RABBITMQ_USER=train_app
RABBITMQ_PASSWORD=train_app

# Host ports. Change these if something already owns them locally — nothing
# else needs editing. The two dev UIs bind to 127.0.0.1 only.
GATEWAY_PORT=3000
RABBITMQ_MANAGEMENT_PORT=15672
MAILPIT_UI_PORT=8025

# gRPC internal endpoints
CATALOG_GRPC_URL=catalog:50051
IDENTITY_GRPC_URL=identity:50051
INVENTORY_GRPC_URL=inventory:50051
BOOKING_GRPC_URL=booking:50051
PAYMENT_GRPC_URL=payment:50051
NOTIFICATION_GRPC_URL=notification:50051

TOKEN_BEARER=bearer
TOKEN_SECRET=b8625c0257dfe17b5a57a655701f923a6b1440f2fd68c47eb3dfbb5074b955fa
ENCRYPTION_KEY=03006a48c7853e041dceeb54c34a2ef9715dada3b83d104cf48c36e874237813
ENCRYPTION_ALGORITHM=aes-cbc-256
HASH_SALT=8
CIPHER_IV_SIZE=16