# compiled output
/dist
/node_modules
/build

# Temporary import probe; ignore it if tests stop early.
apps/*/src/alias-import-probe.ts

# TypeScript build cache
*.tsbuildinfo

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# Editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.claude/

# Local agent notes
CLAUDE.md

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Environment files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Local JWT keys; generate with `npm run keys:generate`.
# Keep private keys out of Git to prevent forged tokens.
*.pem
/config/jwt/

# Temporary files
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Node.js diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
