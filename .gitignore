# compiled output
/dist
/node_modules
/build

# Written and removed by test/skeleton/lib-imports.spec.ts; ignored so an
# interrupted run can never commit it.
apps/*/src/alias-import-probe.ts

# TypeScript build cache
*.tsbuildinfo

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.claude/

# Personal agent notes.
CLAUDE.md

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Local development JWT key pair. Generate with `npm run keys:generate`.
# Never commit a private key: a clone with it can mint tokens the gateway trusts.
*.pem
/config/jwt/

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
