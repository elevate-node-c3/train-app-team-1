{
  "name": "train-app-team-1",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "migration:generate": "tsx node_modules/typeorm/cli.js migration:generate -d",
    "catalog:migration:generate": "tsx node_modules/typeorm/cli.js migration:generate -d apps/catalog/src/database/data-source.ts",
    "catalog:migration:run": "tsx node_modules/typeorm/cli.js migration:run -d apps/catalog/src/database/data-source.ts",
    "catalog:migration:revert": "tsx node_modules/typeorm/cli.js migration:revert -d apps/catalog/src/database/data-source.ts",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/gateway/src/main",
    "lint": "oxlint --type-aware apps/ libs/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --passWithNoTests --config ./vitest.config.e2e.ts",
    "keys:generate": "node scripts/generate-dev-keys.mjs",
    "seed:staff": "tsx apps/identity/src/database/seeds/staff-accounts.seed.ts",
    "migration:show": "tsx node_modules/typeorm/cli.js migration:show -d",
    "migration:run": "tsx node_modules/typeorm/cli.js migration:run -d",
    "migration:revert": "tsx node_modules/typeorm/cli.js migration:revert -d"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.2.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.2",
    "amqplib": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "joi": "^18.3.0",
    "jose": "^6.2.13",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "yaml": "^2.9.1"
  }
}
