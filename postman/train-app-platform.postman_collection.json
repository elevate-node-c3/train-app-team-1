        {
          "name": "Ping All Microservices (/api/v1/ping-all)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"All seven services reported\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.gateway).to.be.ok;",
                  "    const services = json.data.services;",
                  "    pm.expect(services).to.have.property('catalog');",
                  "    pm.expect(services).to.have.property('identity');",
                  "    pm.expect(services).to.have.property('inventory');",
                  "    pm.expect(services).to.have.property('booking');",
                  "    pm.expect(services).to.have.property('payment');",
                  "    pm.expect(services).to.have.property('notification');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ping-all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ping-all"
              ]
            },
            "description": "Dispatches gRPC health queries to all microservices carrying the correlation ID."
          },
          "response": []
