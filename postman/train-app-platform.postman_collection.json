{
  "info": {
    "_postman_id": "c1f7b8a2-94d3-4f90-a7d1-e6a8d7a4e921",
    "name": "Train App - Platform Skeleton, Health & Auth",
    "description": "Postman collection covering health, readiness, liveness, unified envelope testing, and the AUTH-1/AUTH-2/AUTH-3 flows across all 7 services (gateway, catalog, identity, inventory, booking, payment, notification).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Gateway (External Entrypoint)",
      "description": "Endpoints served by the Gateway on host port 3000.",
      "item": [
        {
          "name": "Aggregated Health (Arabic Default)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Standard Arabic response envelope\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.message).to.eql(\"تمت العملية بنجاح\");",
                  "    pm.expect(json.error).to.be.null;",
                  "    pm.expect(json.correlationId).to.be.a('string');",
                  "    pm.expect(json.timestamp).to.be.a('string');",
                  "    pm.expect(json.data.status).to.be.oneOf(['ready', 'degraded']);",
                  "});",
                  "",
                  "pm.test(\"Capture correlation ID\", function () {",
                  "    const corrId = pm.response.headers.get('x-correlation-id');",
                  "    pm.expect(corrId).to.be.ok;",
                  "    pm.environment.set(\"lastCorrelationId\", corrId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{acceptLanguage}}",
                "description": "Defaults to 'ar' for Arabic envelope",
                "type": "text"
              },
              {
                "key": "x-correlation-id",
                "value": "{{customCorrelationId}}",
                "description": "Optional custom correlation ID",
                "type": "text",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Returns the aggregated readiness status of the Gateway and all six downstream services via gRPC."
          },
          "response": []
        },
        {
          "name": "Aggregated Health (English)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
