{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/train-app-server/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/train-app-server/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/train-app-server",
  "projects": {
    "api_gateway": {
      "type": "application",
      "root": "apps/api_gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api_gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api_gateway/tsconfig.app.json"
      }
    },
    "bookings": {
      "type": "application",
      "root": "apps/bookings",
      "entryFile": "main",
      "sourceRoot": "apps/bookings/src",
      "compilerOptions": {
        "tsConfigPath": "apps/bookings/tsconfig.app.json"
      }
    },
    "catalog": {
      "type": "application",
      "root": "apps/identity/catalog",
      "entryFile": "main",
      "sourceRoot": "apps/identity/catalog/src",
      "compilerOptions": {
        "tsConfigPath": "apps/identity/catalog/tsconfig.app.json"
      }
    },
    "identity": {
      "type": "application",
      "root": "apps/identity",
      "entryFile": "main",
      "sourceRoot": "apps/identity/src",
      "compilerOptions": {
          "builder": "rspack",
        "tsConfigPath": "apps/identity/tsconfig.app.json"
      }
    },
    "inventory": {
      "type": "application",
      "root": "apps/inventory",
      "entryFile": "main",
      "sourceRoot": "apps/inventory/src",
      "compilerOptions": {
        "tsConfigPath": "apps/inventory/tsconfig.app.json"
      }
    }
  }
}
