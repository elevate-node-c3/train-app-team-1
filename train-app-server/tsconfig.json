{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],
    // "baseUrl": "./",
    "paths": {}
  },
  "files": [],
  "references": [
    {
      "path": "./apps/api_gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/catalog/tsconfig.app.json"
    },
    {
      "path": "./apps/identity/tsconfig.app.json"
    },
    {
      "path": "./apps/inventory/tsconfig.app.json"
    },
    {
      "path": "./apps/bookings/tsconfig.app.json"
    }
  ]
}
